{
  "name": "eu_trade_pipeline",
  "description": "Lands the COMEXT months of the window from Eurostat into the Volume eu_trade.landing.comext, then builds bronze, silver, gold and the views of the business questions over the pending ones.",
  "max_concurrent_runs": 1,
  "performance_target": "STANDARD",
  "git_source": {
    "git_url": "https://github.com/rdiguglielmo/eu-trade-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 20 * ?",
    "timezone_id": "Europe/Brussels",
    "pause_status": "PAUSED"
  },
  "parameters": [
    {
      "name": "start_period",
      "default": "202601"
    },
    {
      "name": "end_period",
      "default": ""
    }
  ],
  "environments": [
    {
      "environment_key": "land",
      "spec": {
        "environment_version": "6",
        "dependencies": ["py7zr==1.1.4"]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "land",
      "environment_key": "land",
      "notebook_task": {
        "notebook_path": "notebooks/00_land",
        "source": "GIT"
      }
    },
    {
      "task_key": "bronze_ingest",
      "depends_on": [{"task_key": "land"}],
      "notebook_task": {
        "notebook_path": "notebooks/01_bronze_ingest",
        "source": "GIT"
      }
    },
    {
      "task_key": "silver_transform",
      "depends_on": [{"task_key": "bronze_ingest"}],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver_transform",
        "source": "GIT"
      }
    },
    {
      "task_key": "silver_quality_checks",
      "depends_on": [{"task_key": "silver_transform"}],
      "notebook_task": {
        "notebook_path": "notebooks/03_silver_quality_checks",
        "source": "GIT"
      }
    },
    {
      "task_key": "gold_dimensional_model",
      "depends_on": [{"task_key": "silver_quality_checks"}],
      "notebook_task": {
        "notebook_path": "notebooks/04_gold_dimensional_model",
        "source": "GIT"
      }
    },
    {
      "task_key": "gold_quality_checks",
      "depends_on": [{"task_key": "gold_dimensional_model"}],
      "notebook_task": {
        "notebook_path": "notebooks/05_gold_quality_checks",
        "source": "GIT"
      }
    },
    {
      "task_key": "gold_views",
      "depends_on": [{"task_key": "gold_quality_checks"}],
      "notebook_task": {
        "notebook_path": "notebooks/06_gold_views",
        "source": "GIT"
      }
    }
  ]
}
